# ==============================================================================
# Configuration d'environnement - QCMed (.env.example)
# Copiez ce fichier sous le nom '.env' dans le dossier BACKEND/ et remplissez les valeurs.
# NE COMMITEZ JAMAIS LE FICHIER .env DANS GIT !
# ==============================================================================

# Port d'écoute du serveur Express (par défaut: 3000)
PORT=3000

# Environnement d'exécution ('development' ou 'production')
NODE_ENV=development

# URL de base de l'application (utilisée pour les liens dans les emails et redirection)
BASE_URL=http://localhost:3000

# Chaîne de connexion PostgreSQL (Neon ou local)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clé secrète de signature des cookies de session (OBLIGATOIRE - générer une clé aléatoire forte)
# Ex: openssl rand -hex 32
SESSION_SECRET=remplacez_par_une_chaine_secrete_aleatoire_tres_longue

# Clé API SendGrid pour l'envoi des emails
# Commence généralement par 'SG.'
SENDGRID_API_KEY=SG.votre_cle_api_sendgrid

# Liste des emails ayant les droits administrateur (séparés par des virgules)
ADMIN_EMAILS=admin@exemple.com,contact@exemple.com

# Adresse email qui reçoit les signalements d'erreurs sur les questions
REPORT_EMAIL=contact@exemple.com
